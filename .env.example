# Copy to .env.local and fill in. Never commit .env.local.

# Public site origin, used for canonical URLs, sitemap and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://apxtraining.in

# Razorpay API keys from Dashboard > Account & Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Subscription plan ids from Dashboard > Subscriptions > Plans.
# Create one recurring monthly plan per membership tier, then paste the plan_xxx ids here.
RAZORPAY_PLAN_COMMUNITY=
RAZORPAY_PLAN_COACHED=
RAZORPAY_PLAN_ONE_TO_ONE=

# The contact form needs no keys. It opens WhatsApp with the enquiry prefilled,
# using the number set in lib/content.ts.
